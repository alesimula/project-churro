--- a/dumb_driver.c	2026-10-16 22:31:18.009832838 +0200
+++ b/dumb_driver.c	2026-10-16 22:31:18.013832278 +0200
@@ -69,7 +69,95 @@
 INIT_DUMB_DRIVER(komeda)
 INIT_DUMB_DRIVER(marvell)
 INIT_DUMB_DRIVER(meson)
-INIT_DUMB_DRIVER(nouveau)
+/*
+ * Churro: nouveau gets real buffers instead of dumb ones. The allocator and Mesa only open
+ * render nodes, where DRM refuses dumb buffers, and nouveau's display scans out of VRAM only.
+ * Linear, pitch aligned to 256 (display needs 64, NVK linear images more); VRAM, allowed to
+ * spill to system memory, unless only the CPU uses the buffer (cached system memory then).
+ */
+#include <sys/mman.h>
+#include <xf86drm.h>
+#include <nouveau_drm.h>
+
+static int nouveau_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t format,
+			     uint64_t use_flags)
+{
+	struct drm_nouveau_gem_new req = { 0 };
+	/* llvmpipe/softpipe render in 64x64 tiles: pad like drv_dumb_bo_create (not YV12, whose
+	 * plane layout Android fixes) */
+	uint32_t h = format == DRM_FORMAT_YVU420_ANDROID ? height
+							 : ALIGN(height, MESA_LLVMPIPE_TILE_SIZE);
+	int ret;
+
+	ret = drv_bo_from_format(bo, ALIGN(drv_stride_from_format(format, width, 0), 256), 1, h,
+				 format);
+	if (ret)
+		return ret;
+
+	req.info.size = ALIGN(bo->meta.total_size, 65536);
+	req.align = 65536;
+	req.info.domain = NOUVEAU_GEM_DOMAIN_VRAM | NOUVEAU_GEM_DOMAIN_GART;
+	if ((use_flags & BO_USE_SW_MASK) &&
+	    !(use_flags & (BO_USE_SCANOUT | BO_USE_RENDERING | BO_USE_TEXTURE)))
+		req.info.domain = NOUVEAU_GEM_DOMAIN_GART;
+	if (use_flags & BO_USE_SW_MASK)
+		req.info.domain |= NOUVEAU_GEM_DOMAIN_MAPPABLE;
+
+	ret = drmCommandWriteRead(bo->drv->fd, DRM_NOUVEAU_GEM_NEW, &req, sizeof(req));
+	if (ret) {
+		drv_loge("DRM_NOUVEAU_GEM_NEW failed (%llu bytes, domain 0x%x): %d\n",
+			 (unsigned long long)req.info.size, req.info.domain, ret);
+		return ret;
+	}
+	bo->handle.u32 = req.info.handle;
+	return 0;
+}
+
+static int nouveau_bo_create_with_modifiers(struct bo *bo, uint32_t width, uint32_t height,
+					    uint32_t format, const uint64_t *modifiers,
+					    uint32_t count)
+{
+	if (!drv_has_modifier(modifiers, count, DRM_FORMAT_MOD_LINEAR))
+		return -EINVAL;
+	return nouveau_bo_create(bo, width, height, format, BO_USE_SCANOUT | BO_USE_RENDERING);
+}
+
+static void *nouveau_bo_map(struct bo *bo, struct vma *vma, uint32_t map_flags)
+{
+	struct drm_nouveau_gem_info info = { .handle = bo->handle.u32 };
+
+	if (drmCommandWriteRead(bo->drv->fd, DRM_NOUVEAU_GEM_INFO, &info, sizeof(info))) {
+		drv_loge("DRM_NOUVEAU_GEM_INFO failed: %d\n", errno);
+		return MAP_FAILED;
+	}
+	vma->length = bo->meta.total_size;
+	return mmap(NULL, vma->length, drv_get_prot(map_flags), MAP_SHARED, bo->drv->fd,
+		    info.map_handle);
+}
+
+/* CPU access: wait for the GPU first (writers only for reads, everyone for writes) */
+static int nouveau_bo_invalidate(struct bo *bo, struct mapping *mapping)
+{
+	struct drm_nouveau_gem_cpu_prep prep = { .handle = bo->handle.u32 };
+
+	if (mapping->vma->map_flags & BO_MAP_WRITE)
+		prep.flags = NOUVEAU_GEM_CPU_PREP_WRITE;
+	return drmCommandWrite(bo->drv->fd, DRM_NOUVEAU_GEM_CPU_PREP, &prep, sizeof(prep));
+}
+
+const struct backend backend_nouveau = {
+	.name = "nouveau",
+	.init = dumb_driver_init,
+	.bo_create = nouveau_bo_create,
+	.bo_create_with_modifiers = nouveau_bo_create_with_modifiers,
+	.bo_destroy = drv_gem_bo_destroy,
+	.bo_import = drv_prime_bo_import,
+	.bo_export = drv_prime_bo_export,
+	.bo_map = nouveau_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.bo_invalidate = nouveau_bo_invalidate,
+	.resolve_format_and_use_flags = drv_resolve_format_and_use_flags_helper,
+};
 INIT_DUMB_DRIVER(radeon)
 INIT_DUMB_DRIVER_WITH_NAME(sun4i_drm, "sun4i-drm")
 INIT_DUMB_DRIVER(synaptics)
