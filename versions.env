# Project Churro: versions of everything the build downloads or builds from source.
# Read (sourced) by the scripts named in each section. Every value can be overridden for one
# build from the environment, e.g.  MESA_VER=26.2.5 sudo -E ./churro.sh auto in.bin out.img
# Not here: what comes from the recovery image itself (GKI kernel commit, its toolchain and
# Rust version: tools/prepare.sh reads them from the image), and what must match the image
# (docs/09-version-support.md):
#   kmod/patches/<kernel series>/series.env   follows the kernel (driver list tag)
#   versions/api<NN>.env                      follows the image's Android release (read below)
# Changing a value rebuilds what uses it: the kernel cache is keyed on ARCH_LINUX_CONFIG_TAG,
# Mesa's on MESA_VER/LIBDRM_VER/NDK_VER, downloads are cached per version.

## Pins that follow the image (churro.sh exports CHURRO_API = the image's Android API level and
## CHURRO_IMAGE_BUILD = Google's build number of the image, ro.build.version.incremental)
# Every line everywhere is `: "${NAME:=value}"`, which keeps a value that is already set, so the
# most specific file is read first: versions/api<NN>-<build>.env files (pins that differ from that
# image build on; newest first, none newer than the image), then versions/api<NN>.env, then the
# rest of this file. No file for the image's release stops the build: another release's pins can
# fit by symbol names and still be wrong. Scripts run without CHURRO_API get only the pins below.
if [ -n "${CHURRO_API:-}" ]; then
  _vd=$(dirname "${BASH_SOURCE[0]}")/versions
  [ -f "$_vd/api$CHURRO_API.env" ] || { echo "no pins for Android API $CHURRO_API images: create versions/api$CHURRO_API.env (docs/09-version-support.md)" >&2; return 1 2>/dev/null || exit 1; }
  for _vn in $(ls "$_vd" | sed -n "s/^api$CHURRO_API-\([0-9][0-9]*\)\.env\$/\1/p" | sort -rn); do
    if [ "$_vn" -le "${CHURRO_IMAGE_BUILD:-0}" ]; then . "$_vd/api$CHURRO_API-$_vn.env"; fi
  done
  . "$_vd/api$CHURRO_API.env"
fi

## Kernel driver selection: ARCH_LINUX_CONFIG_TAG is pinned per kernel series, in
## kmod/patches/<series>/series.env (read by tools/prepare.sh and kmod/build-kernel.sh).

## Firmware (features/firmware-extra)
# Binary firmware files drivers load at runtime (GPU GuC/HuC, Wi-Fi, Bluetooth, audio DSP), not
# kernels: the kernel is always Google's GKI at the image's own commit (see the top).
# linux-firmware: release tag (a date) of https://cdn.kernel.org/pub/linux/kernel/firmware/
# (linux-firmware-<tag>.tar.xz; repo: https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git)
: "${CHURRO_LINUX_FIRMWARE:=20260916}"
: "${CHURRO_SOF:=2026.09.2}"                  # thesofproject/sof-bin release
: "${CHURRO_REGDB:=master-2026-09-03}"        # wireless-regdb tag

## Graphics (gfx/build-mesa.sh; the NDK is also used by gfx/build-minigbm.sh and crypto/)
: "${MESA_VER:=26.2.4}"
: "${LIBDRM_VER:=2.4.133}"
# libva: only the build-time dependency of Mesa's VA state tracker (headers + static core);
# at runtime the image's own libva (VA-API 1.22) loads the built *_drv_video.so. Keep the
# version matching the image's VA-API (1.22 = libva 2.22). It follows the Android release, but
# stays here while one Mesa build serves every image (docs/09).
: "${LIBVA_VER:=2.22.0}"
: "${NDK_VER:=r28c}"

## Setup flow overlay (features/setup-no-ota)
# Google's Android SDK build-tools (aapt2, zipalign, apksigner; apksigner needs a JRE). Any recent
# release works: only used to build a small resource overlay.
: "${CHURRO_BUILDTOOLS_URL:=https://dl.google.com/android/repository/build-tools_r37_linux.zip}"
: "${CHURRO_BUILDTOOLS_SHA1:=70954e99f4c3d9d46ee70fa32624672fe7cd6ebe}"   # change together with the URL

## BoringSSL (crypto/build-boringssl.sh, feature crypto-generic)
# The commits (BORINGSSL_REV, BORINGSSL_HTTPENGINE_REV) follow the image: versions/api<NN>.env.
# Go: only runs BoringSSL's FIPS hash injector; BoringSSL's go.mod needs >= 1.25.
: "${BORINGSSL_GO_VER:=1.25.14}"
: "${BORINGSSL_GO_SHA256:=a21ae5633a269bcd7e90cf767e48225633795e99d831742cbf3397064fee7712}"

## Host tools (tools/build-erofs-utils.sh, tools/build-secilc.sh)
: "${EROFS_VER:=v1.8.10}"
# SELinux userspace release for secilc (tools/check-sepolicy.sh): >= 3.8 reads Google's policy
: "${SELINUX_VER:=3.11}"
