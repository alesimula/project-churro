# NVIDIA GPUs driven by nouveau (display + buffers in VRAM, minigbm's nouveau backend).
# GL: Mesa picks by GPU - Zink on NVK for Kepler and newer (gfx/mesa-patches/
# nouveau-zink-from-kepler.patch; upstream only from Turing), nouveau GL for Fermi and older
# (NVK has no support). debug.mesa.nouveau.use.zink=true/false overrides it. Vulkan for apps:
# NVK. RenderEngine/HWUI stay on GL (Skia's Vulkan backends not tried on NVK yet; NVK has
# AHardwareBuffer support only through gfx/mesa-patches/nvk-android-hardware-buffer.patch).
on early-init
    setprop ro.hardware.egl mesa
    setprop ro.hardware.vulkan nouveau
    setprop ro.hwui.use_vulkan false
    setprop debug.renderengine.vulkan false
    setprop debug.renderengine.backend skiaglthreaded
    setprop debug.hwui.renderer skiagl
