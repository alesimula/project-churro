# Pins for Android 17 (API 37) images: what must match the image's own userspace
# (docs/09-version-support.md). Read by versions.env when CHURRO_API=37. Pins that have to differ
# from some image build on go into versions/api37-<that build number>.env (only those lines).

# Newest image build (ro.build.version.incremental) converted and booted with these pins: a newer
# one builds with a notice. Raise it with the "Tested images" table in docs/09.
: "${CHURRO_TESTED_BUILD:=16833189}"

## Software security (features/security-software), core libraries (features/libs-generic)
# Google's public Android 17 emulator image: software KeyMint + Gatekeeper come from it.
# Also libz + bionic (libc, libm, linker). Must be the image's Android release (same API level,
# checked at build time). Newer revision: x86_64-37.0_rNN.zip from the same repository; update
# URL + SHA1 together.
: "${CHURRO_EMU_URL:=https://dl.google.com/android/repository/sys-img/google_apis/x86_64-37.0_r06.zip}"
: "${CHURRO_EMU_SHA1:=629e507fd5b737c2c836b12b52c81cd0e3b12399}"

## BoringSSL (crypto/build-boringssl.sh, feature crypto-generic)
# Platform libcrypto/libssl. Source: https://boringssl.googlesource.com/boringssl (upstream;
# GitHub mirror: https://github.com/google/boringssl). AOSP imports it as platform/external/boringssl.
# Upstream commit (or tag) the image's exports pin. The image's
# BoringSSL sits between upstream d03dbc3e5 (2026-05-12, adds SSL_get_signature_algorithm_used,
# which it exports) and 956bac6e4 (2026-05-22, adds CBS_get_u48, which it doesn't); this is the
# newest commit of that window. Newer ones pass the export check too (it only requires what the
# image exports), but struct layouts and behaviour are not checked: see docs/05.
: "${BORINGSSL_REV:=e2da59b2d9e85f20a87d4b9116bc4a3de3525603}"   # 2026-05-22
# libcrypto_httpengine.so (Tethering APEX; crypto/build-boringssl-httpengine.sh): exactly the
# commit Chromium's DEPS pins for the image's HttpEngine version (150.0.7871.41).
# Source: https://android.googlesource.com/platform/external/cronet (stable/third_party/boringssl)
: "${BORINGSSL_HTTPENGINE_REV:=3a9254f16eda7a4c5d2260039ff23456a0a34de4}"   # 2026-06-01
# The HttpEngine (Chromium) version that commit belongs to: the string in the Tethering APEX's
# libhttpengine.so. The build notes it when the image's differs (features/crypto-generic).
: "${BORINGSSL_HTTPENGINE_FOR:=150.0.7871.41}"

## minigbm (gfx/build-minigbm.sh): AOSP external/minigbm and the headers it builds against, at
## android17-release revisions (https://android.googlesource.com/platform/<repo>). They follow the
## image's graphics services (allocator, mapper, HALs), not the kernel; the build refuses a
## result that lacks a symbol the image's binaries use.
: "${MINIGBM_REV:=ce79bbee67b3e2ea7abb110e1415e9ceceaa6471}"             # external/minigbm
: "${MINIGBM_CORE_REV:=545d2487e38192a2ce25040897ced877cf6b4f53}"        # system/core (libcutils, libsystem, libsync)
: "${MINIGBM_LOGGING_REV:=d35ba620451b28512f46ebb5421f783fd77968d5}"     # system/logging (liblog)
: "${MINIGBM_LIBHARDWARE_REV:=97ee3e33ec5ba48c0eca8341ed377ac4497a0678}" # hardware/libhardware
: "${MINIGBM_NATIVE_REV:=ae266dcb706d083868578cfedce381ef44488a07}"      # frameworks/native (nativewindow, binder NDK ...)
: "${MINIGBM_DMABUFHEAP_REV:=09fe72b6ce0feead1b97c2859979b125f815d9b0}"  # system/memory/libdmabufheap
: "${MINIGBM_LIBBASE_REV:=fef4173e19d97cd4b4fc09a06bccbf800d0d3937}"     # system/libbase
: "${MINIGBM_INTERFACES_REV:=0162af698935100a590b7359581ac8b1b80693e5}"  # hardware/interfaces (AIDL: graphics.common, common)
