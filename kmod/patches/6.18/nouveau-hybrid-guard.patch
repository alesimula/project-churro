+/*
+ * Churro: bind on the GPU showing the boot screen, or when no other display controller is
+ * present (NVIDIA-only desktops, discrete-only laptops). On hybrid machines the other GPU drives
+ * the panel and Android's graphics, and binding here would also remove its firmware framebuffer
+ * (simpledrm). Laptops with a MUX in discrete mode can keep the iGPU visible on PCI: there the
+ * boot display decides (video_is_primary_device: the boot VGA device, or the firmware
+ * framebuffer lies in this GPU's BARs). nouveau.hybrid=1 binds anyway.
+ */
+static int nouveau_hybrid;
+MODULE_PARM_DESC(hybrid, "bind even if another display controller is present (default: 0)");
+module_param_named(hybrid, nouveau_hybrid, int, 0400);
+
+static bool
+nouveau_other_display(void)
+{
+	struct pci_dev *d = NULL;
+
+	while ((d = pci_get_base_class(PCI_BASE_CLASS_DISPLAY, d))) {
+		if (d->vendor != PCI_VENDOR_ID_NVIDIA) {
+			pci_dev_put(d);
+			return true;
+		}
+	}
+	return false;
+}
+
 static int nouveau_drm_probe(struct pci_dev *pdev,
 			     const struct pci_device_id *pent)
 {
@@ -861,6 +888,11 @@
 	const struct drm_format_info *format;
 	int ret;
 
+	if (!nouveau_hybrid && !video_is_primary_device(&pdev->dev) && nouveau_other_display()) {
+		dev_info(&pdev->dev, "not the boot display and another display controller is present, not binding (nouveau.hybrid=1 overrides)\n");
+		return -ENODEV;
+	}
+
 	if (vga_switcheroo_client_probe_defer(pdev))
 		return -EPROBE_DEFER;
 
