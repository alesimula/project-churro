Churro: turn off DSC that the firmware (GOP) left enabled.

High refresh eDP panels (e.g. 2560x1600@240) need DSC, so the laptop's GOP enables it on the
head and in the panel. nouveau never programs DSC: the inherited head kept compressing at the new
60 Hz mode while the panel (re-powered by link training) no longer decompressed -> a squeezed,
noisy strip on the left quarter of the screen; with a second monitor on another head the update
was rejected instead (core notifier timeout, black screen). Clear the head's DSC state on every
modeset (Turing+ classes, the method offsets are the same up to GB20x) and the sink's DSC enable
before link training.

diff --git a/drivers/gpu/drm/nouveau/dispnv50/headc57d.c b/drivers/gpu/drm/nouveau/dispnv50/headc57d.c
index 3f8ba49..54fe475 100644
--- a/drivers/gpu/drm/nouveau/dispnv50/headc57d.c
+++ b/drivers/gpu/drm/nouveau/dispnv50/headc57d.c
@@ -206,7 +206,7 @@ headc57d_mode(struct nv50_head *head, struct nv50_head_atom *asyh)
 	const int i = head->base.index;
 	int ret;
 
-	if ((ret = PUSH_WAIT(push, 15)))
+	if ((ret = PUSH_WAIT(push, 18)))
 		return ret;
 
 	PUSH_MTHD(push, NVC57D, HEAD_SET_RASTER_SIZE(i),
@@ -235,6 +235,12 @@ headc57d_mode(struct nv50_head *head, struct nv50_head_atom *asyh)
 	PUSH_MTHD(push, NVC57D, HEAD_SET_PIXEL_CLOCK_FREQUENCY_MAX(i),
 		  NVVAL(NVC57D, HEAD_SET_PIXEL_CLOCK_FREQUENCY_MAX, HERTZ, m->clock * 1000));
 
+	/* Churro: the firmware (GOP) may leave DSC enabled on a head (e.g. for a high
+	 * refresh eDP panel); nouveau never compresses, so always turn it off.
+	 */
+	PUSH_MTHD(push, NVC57D, HEAD_SET_DSC_CONTROL(i), 0x00000000,
+				HEAD_SET_DSC_PPS_CONTROL(i), 0x00000000);
+
 	/*XXX: HEAD_USAGE_BOUNDS, doesn't belong here. */
 	PUSH_MTHD(push, NVC57D, HEAD_SET_HEAD_USAGE_BOUNDS(i),
 		  NVDEF(NVC57D, HEAD_SET_HEAD_USAGE_BOUNDS, CURSOR, USAGE_W256_H256) |
diff --git a/drivers/gpu/drm/nouveau/dispnv50/headca7d.c b/drivers/gpu/drm/nouveau/dispnv50/headca7d.c
index eeaeb15..44c632a 100644
--- a/drivers/gpu/drm/nouveau/dispnv50/headca7d.c
+++ b/drivers/gpu/drm/nouveau/dispnv50/headca7d.c
@@ -222,7 +222,7 @@ headca7d_mode(struct nv50_head *head, struct nv50_head_atom *asyh)
 	const int i = head->base.index;
 	int ret;
 
-	ret = PUSH_WAIT(push, 11);
+	ret = PUSH_WAIT(push, 14);
 	if (ret)
 		return ret;
 
@@ -251,6 +251,10 @@ headca7d_mode(struct nv50_head *head, struct nv50_head_atom *asyh)
 	PUSH_MTHD(push, NVCA7D, HEAD_SET_PIXEL_CLOCK_FREQUENCY_MAX(i),
 		  NVVAL(NVCA7D, HEAD_SET_PIXEL_CLOCK_FREQUENCY_MAX, HERTZ, m->clock * 1000));
 
+	/* Churro: firmware may leave DSC enabled, see headc57d_mode(). */
+	PUSH_MTHD(push, NVCA7D, HEAD_SET_DSC_CONTROL(i), 0x00000000,
+				HEAD_SET_DSC_PPS_CONTROL(i), 0x00000000);
+
 	return 0;
 }
 
