# Kernel series 6.18 (android17-6.18): what follows the kernel, besides the patches in this
# folder (docs/09-version-support.md). Read before versions.env by tools/prepare.sh and
# kmod/build-kernel.sh; a value set in the environment wins.

# Driver list: Arch Linux's kernel package config of the same series, used only as a list of
# options: every module it builds from a consumer-PC driver directory is switched on in our
# build of Google's kernel source (kmod/profiles/generic.conf). Pinned, not "newest": Arch's
# 6.18 tags ended at 6.18.13.arch1-1 with the same module list (6227 =m; only tool version
# strings differ), and a newer series' list would drop drivers this source has.
# Source: https://gitlab.archlinux.org/archlinux/packaging/packages/linux (tags: .../-/tags).
: "${ARCH_LINUX_CONFIG_TAG:=6.18.9.arch1-1}"
# The file's name in that repo: `config` up to 6.18.9, `config.x86_64` from 6.18.13 on (and in
# every later series: set it in the next series.env).
: "${ARCH_LINUX_CONFIG_FILE:=config}"

# Newest kernel build (the ab number) converted and booted with this folder: a newer one builds
# with a notice. Raise it with the "Tested images" table in docs/09.
: "${CHURRO_TESTED_KBUILD:=16560873}"
